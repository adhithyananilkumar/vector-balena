# Vector server settings. Copy to .env for running on the host (`npm run dev`). In the Docker stack the
# compose file and the stack's secrets file supply these, so you normally do not need this file there.
# Every setting is described in docs/vector-server-configuration.md.

PORT=3001
NODE_ENV=development

# --- openBalena -----------------------------------------------------------------------------------------------
# openBalena API as this server reaches it, and its software version (selects compatible fields).
OPEN_BALENA_API_URL=https://api.my-open-balena-server.com
OPEN_BALENA_API_VERSION=v52.2.3
# Optional OData override (v6 or v7).
OPEN_BALENA_ODATA_VERSION=

# Secret used to verify openBalena bearer tokens. Must equal the API's JSON web token secret.
OPEN_BALENA_JWT_SECRET=

# Internal PostgREST endpoint. Never expose it to browsers.
OPEN_BALENA_POSTGREST_URL=http://localhost:3002

# Optional numeric user.id that becomes the first global-admin at startup.
# WARNING: without this or an existing global-admin role every signed-in user is a full administrator.
OPEN_BALENA_BOOTSTRAP_USER_ID=
OPEN_BALENA_ORGANIZATION_ADMIN_ASSIGNABLE_ROLES=

# --- browser access ---------------------------------------------------------------------------------------------
# Origins of the hosted Vector UI that may call this server (comma separated, bare http(s) origins).
VECTOR_ALLOWED_ORIGINS=http://localhost:3000
# Public address of this server; default for OPEN_BALENA_OS_METADATA_URL.
VECTOR_PUBLIC_URL=http://localhost:3001

# --- storage ---------------------------------------------------------------------------------------------------
# S3-compatible endpoint (SeaweedFS, MinIO or AWS S3), path-style.
OPEN_BALENA_S3_URL=https://s3.my-open-balena-server.com
OPEN_BALENA_S3_ACCESS_KEY=
OPEN_BALENA_S3_SECRET_KEY=
OPEN_BALENA_S3_REGISTRY_BUCKET=registry-data
OPEN_BALENA_S3_REGION=us-east-1
# Private bucket for device-type.json metadata (API v46.1+ Host OS sync).
OPEN_BALENA_OS_METADATA_BUCKET=balena-os-metadata
# Server address the API can reach for that metadata. Defaults to VECTOR_PUBLIC_URL.
OPEN_BALENA_OS_METADATA_URL=
OPEN_BALENA_OS_METADATA_SOURCE_URL=https://resin-production-img-cloudformation.s3.amazonaws.com/images
# Mirror the API's semicolon-separated CONTRACT_ALLOWLIST. Empty means all local device types.
CONTRACT_ALLOWLIST=

# --- remote access (terminal and file transfer) ------------------------------------------------------------------
# openBalena CONNECT tunnel, for example http://vpn:3128 inside the stack. Empty turns built-in remote access off.
OPEN_BALENA_TUNNEL_URL=
OPEN_BALENA_SSH_TARGET_PORT=22222
# Comma-separated <uuid>=SHA256:<fingerprint> pins; a bare SHA256:<fingerprint> applies to every device.
OPEN_BALENA_SSH_HOST_KEYS=
# Learn host keys on first use instead of requiring pins (demo convenience).
OPEN_BALENA_SSH_TRUST_ON_FIRST_USE=false
OPEN_BALENA_SSH_ALLOW_UNVERIFIED_HOST_KEYS=false
# Trusted reverse proxies (IPs or CIDRs), when TLS ends in front of this server.
OPEN_BALENA_REMOTE_TRUSTED_PROXIES=
OPEN_BALENA_REMOTE_PUBLIC_ORIGIN=

# --- image maker and deltas --------------------------------------------------------------------------------------
# Folder for downloaded balenaOS images (several GB per device type). Default ./data/base-images
VECTOR_BASE_IMAGES_DIR=
VECTOR_OS_CATALOG_API_URL=
# Delta server for the Delta builds page. Default https://delta.<api host>.
VECTOR_DELTA_URL=
